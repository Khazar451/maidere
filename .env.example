# Maidere Configuration
# =====================
# Copy to .env and adjust. Never commit .env (it is gitignored).

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=qwen2.5:3b
OLLAMA_THINKING_MODEL=deepseek-r1:7b
OLLAMA_NUM_CTX=8192

# Database
DB_PATH=db/maidere.db

# Embeddings (fastembed, runs on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Agent
AGENT_WORKSPACE=workspace
AGENT_TOKEN_LIMIT=6000
AGENT_CHARS_PER_TOKEN=4

# Logging
LOG_PATH=logs/maidere.jsonl
LOG_LEVEL=INFO

# API binding
# Keep 127.0.0.1 unless a TLS-terminating reverse proxy sits in front of Maidere.
API_HOST=127.0.0.1
API_PORT=8000

# API authentication
# Every request needs `Authorization: Bearer <token>`. Leave API_TOKEN empty to
# auto-generate a strong token on first start; it is stored in API_TOKEN_FILE
# with mode 0600 and the desktop launcher passes it to the UI automatically.
API_AUTH_ENABLED=true
API_TOKEN=
API_TOKEN_FILE=~/.config/maidere/token
# Extra browser origins allowed for CORS / WebSocket, comma-separated.
# Loopback origins for API_PORT are always allowed.
ALLOWED_ORIGINS=
# Allow unauthenticated /metrics scrapes from loopback (local Prometheus).
METRICS_ALLOW_LOOPBACK=true

# Uploads
MAX_UPLOAD_BYTES=26214400

# Docker sidecar secrets (docker compose reads this file; both are required)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# GitHub Integration (optional, personal access token for repo/actions access)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# Cloud AI Provider (NVIDIA NIM / OpenAI-Compatible Endpoints)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CLOUD_MODEL=nvidia/nemotron-3-ultra-550b-a55b
