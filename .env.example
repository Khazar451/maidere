# Maidere Configuration
# =====================
# Copy to .env and adjust. Never commit .env (it is gitignored).

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=qwen2.5:3b
OLLAMA_THINKING_MODEL=deepseek-r1:7b
OLLAMA_NUM_CTX=8192

# Paths
# Relative paths are anchored at the repository when you run from a checkout,
# and at $XDG_DATA_HOME/maidere (default ~/.local/share/maidere) when installed.
# MAIDERE_RUNTIME_ROOT overrides that base. Absolute paths are used as given.
# MAIDERE_RUNTIME_ROOT=
# MAIDERE_DATA_DIR=

# Database
DB_PATH=db/maidere.db

# Embeddings (fastembed, runs on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Agent
AGENT_WORKSPACE=workspace
AGENT_TOKEN_LIMIT=6000
AGENT_CHARS_PER_TOKEN=4

# Logging
LOG_PATH=logs/maidere.jsonl
LOG_LEVEL=INFO

# API binding
# Keep 127.0.0.1 unless a TLS-terminating reverse proxy sits in front of Maidere.
API_HOST=127.0.0.1
API_PORT=8000

# API authentication
# Every request needs `Authorization: Bearer <token>`. Leave API_TOKEN empty to
# auto-generate a strong token on first start; it is stored in API_TOKEN_FILE
# with mode 0600 and the desktop launcher passes it to the UI automatically.
API_AUTH_ENABLED=true
API_TOKEN=
API_TOKEN_FILE=~/.config/maidere/token
# Extra browser origins allowed for CORS / WebSocket, comma-separated.
# Loopback origins for API_PORT are always allowed.
ALLOWED_ORIGINS=
# Allow unauthenticated /metrics scrapes from loopback (local Prometheus).
METRICS_ALLOW_LOOPBACK=true

# Uploads
MAX_UPLOAD_BYTES=26214400

# Tool sandbox for `shell` and `code_runner` subprocesses
#   auto       -> bwrap if bubblewrap works here, otherwise restricted (logged as a warning)
#   bwrap      -> require bubblewrap (read-only root, workspace-only writes, no network, fresh namespaces)
#   restricted -> argument-level confinement only; weaker, use when bwrap is impossible
#   off        -> cwd only (development)
# Install with: sudo apt install bubblewrap
TOOL_SANDBOX_MODE=auto
TOOL_SANDBOX_ALLOW_NETWORK=false
TOOL_SANDBOX_MEMORY_MB=1024
TOOL_SANDBOX_MAX_FILE_MB=64
TOOL_SANDBOX_MAX_OUTPUT_CHARS=20000
TOOL_SANDBOX_TIMEOUT_SECONDS=30
# Extra host paths to expose read-only inside the sandbox, comma-separated
TOOL_SANDBOX_EXTRA_RO_PATHS=

# Extra binaries the shell tool may run, comma-separated bare names
# (e.g. uv,pytest,cargo,go,ruff). Empty by default. They still run inside the
# sandbox above; shells, sudo and network clients (bash, sudo, curl, ...) are
# always refused. The sandbox has no network, so commands that download
# packages will fail unless TOOL_SANDBOX_ALLOW_NETWORK=true.
EXTRA_ALLOWED_COMMANDS=

# Web search
# SearXNG is the primary engine. If it is unreachable, Maidere falls back to
# Tavily or Serper (when a key is set) and then DuckDuckGo. Fallback queries
# leave your machine; set false to keep search strictly local.
SEARXNG_URL=http://localhost:8080
SEARCH_FALLBACK_ENABLED=true
TAVILY_API_KEY=
SERPER_API_KEY=

# Vision memory
# How many user turns an uploaded image stays available for follow-up questions
# (the upload turn counts as the first; 0 disables) and the most images kept.
IMAGE_MEMORY_TURNS=2
IMAGE_MEMORY_MAX_IMAGES=4

# Database maintenance
# Seconds between background SQLite WAL checkpoints (0 disables the loop). A
# final compacting checkpoint always runs on clean shutdown.
DB_CHECKPOINT_INTERVAL_SECONDS=3600

# Docker sidecar secrets (docker compose reads this file; both are required)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# GitHub Integration (optional, personal access token for repo/actions access)
GITHUB_TOKEN=
# Optional owner/repo used when a GitHub tool call does not name a repository.
GITHUB_DEFAULT_REPO=

# Generation limits
MAX_CONCURRENT_GENERATIONS=2
MAX_WS_MESSAGE_BYTES=2000000
MIN_FREE_DISK_MB=100

# Cloud AI Provider (NVIDIA NIM / OpenAI-Compatible Endpoints)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CLOUD_MODEL=nvidia/nemotron-3-ultra-550b-a55b
